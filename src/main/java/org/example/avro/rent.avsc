{
  "type": "record",
  "name": "Rent",
  "namespace": "org.example.avro",
  "fields": [
    { "name": "id", "type": "int" },
    { "name": "client", "type": "Client" },
    { "name": "vehicle", "type": "Vehicle" },
    { "name": "beginTime", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "endTime", "type": [ "null", { "type": "long", "logicalType": "timestamp-millis" } ], "default": null },
    { "name": "rentCost", "type": "double" },
    { "name": "isArchived", "type": "boolean" }
  ]
}
